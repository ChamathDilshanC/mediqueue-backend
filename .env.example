# MediQueue FastAPI backend environment
# Copy this file to backend/.env for local development.
# Never commit backend/.env or put server-only secrets in the frontend.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development (SQLite sidecar databases are created automatically).
DATABASE_URL=sqlite+aiosqlite:///./mediqueue.db

# Production: use the Supabase Session Pooler on port 5432.
# URL-encode reserved password characters (@, #, %, /, ?, :) before saving.
# DATABASE_URL=postgresql://postgres.<project-ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# ---------------------------------------------------------------------------
# Supabase Auth
# ---------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
# Browser-safe anon key used for JWT issuer/client validation.
SUPABASE_ANON_KEY=<supabase-anon-key>
# Only needed for projects using HS256 JWT signing.
SUPABASE_JWT_SECRET=<supabase-jwt-secret>
# Only needed for projects using asymmetric JWT signing (recommended).
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Keep false outside local automated tests. This enables trusted development
# headers and must never be enabled in a public deployment.
AUTH_DEV_HEADER_ENABLED=false

# Platform operators who review hospital applications and provision hospitals.
# Comma-separated; matching is case-insensitive and the email must be confirmed
# in Supabase. Leave empty to grant nobody system-admin access.
SYSTEM_ADMIN_EMAILS=
# Seconds to cache Supabase JWKS signing keys (unknown key ids refresh sooner).
JWKS_CACHE_SECONDS=600
DEV_TENANT_ID=00000000-0000-0000-0000-000000000001
DEV_BRANCH_ID=00000000-0000-0000-0000-000000000002

# JSON feature/configuration file. Run the backend from backend/ so this
# relative path resolves to backend/configuration/defaults.json.
CONFIG_PATH=configuration/defaults.json

# ---------------------------------------------------------------------------
# Stripe (backend only)
# ---------------------------------------------------------------------------
# Use test keys locally (sk_test_...) and live keys only in the deployment
# platform's server-side environment settings.
STRIPE_SECRET_KEY=sk_test_replace_me
# Required by POST /v1/webhooks/stripe. Copy the signing secret from the
# Stripe Dashboard webhook endpoint (whsec_...). Subscribe the endpoint to
# checkout.session.completed, checkout.session.async_payment_succeeded and
# checkout.session.expired.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Stripe redirects the browser here after Checkout. These are not secrets.
STRIPE_SUCCESS_URL=http://localhost:3000/patient?payment=success
STRIPE_CANCEL_URL=http://localhost:3000/patient?payment=cancelled
